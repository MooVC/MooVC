<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Keep shared assembly versions compatible with the .NET 10 compiler host. -->
    <RuntimeDependencyVersion>10.0.15</RuntimeDependencyVersion>
    <RuntimeDependencyVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</RuntimeDependencyVersion>
    <!-- Keep Immutable on its own version so updates to other packages cannot change this pin. -->
    <SystemCollectionsImmutableVersion>10.0.15</SystemCollectionsImmutableVersion>
    <SystemCollectionsImmutableVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</SystemCollectionsImmutableVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Apex.Serialization" Version="9.0.0" />
    <PackageVersion Include="Ardalis.GuardClauses" Version="5.0.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Fluentify" Version="3.0.0" />
    <PackageVersion Include="Graphify" Version="1.1.3" />
    <PackageVersion Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="$(RuntimeDependencyVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="[3.11.0,3.12.0)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="[4.4.0,4.5.0)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="[4.4.0,4.5.0)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="[4.4.0,4.5.0)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(RuntimeDependencyVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(RuntimeDependencyVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(RuntimeDependencyVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(RuntimeDependencyVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(RuntimeDependencyVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(RuntimeDependencyVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(RuntimeDependencyVersion)" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="Monify" Version="1.6.3" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Newtonsoft.Json.Bson" Version="1.0.3" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.36.0.15337" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <PackageVersion Include="System.Collections.Immutable" Version="$(SystemCollectionsImmutableVersion)" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageVersion Include="TUnit" Version="1.83.0" />
    <PackageVersion Include="Valuify" Version="1.9.1" />
  </ItemGroup>
</Project>